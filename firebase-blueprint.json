{
  "entities": {
    "UserProfile": {
      "collection": "users",
      "fields": {
        "uid": { "type": "string", "description": "Firebase Auth UID" },
        "displayName": { "type": "string", "description": "User display name" },
        "email": { "type": "string", "description": "User email" },
        "photoURL": { "type": "string", "description": "Profile picture URL" },
        "currentStreak": { "type": "number", "description": "Current consecutive journaling streak days" },
        "longestStreak": { "type": "number", "description": "Longest consecutive streak days" },
        "lastJournalDate": { "type": "string", "description": "YYYY-MM-DD string of last journal entry" },
        "totalEntries": { "type": "number", "description": "Total reflections created" },
        "e2eeEnabled": { "type": "boolean", "description": "Whether client encryption is enabled" },
        "salt": { "type": "string", "description": "Client encryption salt hex if E2EE enabled" },
        "createdAt": { "type": "string", "description": "ISO timestamp" },
        "updatedAt": { "type": "string", "description": "ISO timestamp" }
      }
    },
    "Reflection": {
      "collection": "users/{userId}/reflections",
      "fields": {
        "id": { "type": "string", "description": "Document ID" },
        "userId": { "type": "string", "description": "Owner UID" },
        "title": { "type": "string", "description": "Title or autogenerated prompt theme" },
        "date": { "type": "string", "description": "YYYY-MM-DD" },
        "createdAt": { "type": "string", "description": "ISO creation timestamp" },
        "updatedAt": { "type": "string", "description": "ISO last modified timestamp" },
        "mood": { "type": "string", "description": "Mood: radiant | joyful | calm | reflective | anxious | down | frustrated" },
        "moodScore": { "type": "number", "description": "1 to 5 numerical scale" },
        "tags": { "type": "array", "description": "List of tags (e.g. Work, Health, Gratitude, Personal)" },
        "isEncrypted": { "type": "boolean", "description": "True if payload content is AES-GCM encrypted" },
        "encryptedData": { "type": "string", "description": "Ciphertext payload if encrypted" },
        "iv": { "type": "string", "description": "Initialization vector for decryption" },
        "messages": {
          "type": "array",
          "description": "Conversation turns: [{ role: 'user' | 'model', content: string, timestamp: string }]"
        },
        "summary": { "type": "string", "description": "Gemini generated insight or summary" },
        "actionItems": { "type": "array", "description": "Key takeaways or action prompts" }
      }
    },
    "Analysis": {
      "collection": "users/{userId}/analyses",
      "fields": {
        "id": { "type": "string", "description": "Unique analysis record ID" },
        "userId": { "type": "string", "description": "Owner UID" },
        "type": { "type": "string", "description": "entry | week | month" },
        "targetId": { "type": "string", "description": "Target reflectionId or period identifier (e.g. 2026-W36, 2026-09)" },
        "createdAt": { "type": "string", "description": "ISO timestamp" },
        "summary": { "type": "string", "description": "AI generated reflection summary" },
        "detectedItems": { "type": "array", "description": "Detected calendar/task items" },
        "insights": { "type": "object", "description": "Categorized analysis data (events, tasks, patterns, etc.)" }
      }
    },
    "CalendarItem": {
      "collection": "users/{userId}/calendarItems",
      "fields": {
        "id": { "type": "string", "description": "Unique calendar item ID" },
        "userId": { "type": "string", "description": "Owner UID" },
        "sourceReflectionId": { "type": "string", "description": "Associated reflection ID if any" },
        "title": { "type": "string", "description": "Event or task title" },
        "type": { "type": "string", "description": "event | task | reminder" },
        "date": { "type": "string", "description": "YYYY-MM-DD" },
        "time": { "type": "string", "description": "HH:mm or null" },
        "description": { "type": "string", "description": "Event notes or details" },
        "reminderMinutesBefore": { "type": "number", "description": "Minutes before event for alert" },
        "status": { "type": "string", "description": "confirmed | synced | cancelled" },
        "createdAt": { "type": "string", "description": "ISO timestamp" }
      }
    },
    "Objective": {
      "collection": "users/{userId}/objectives",
      "fields": {
        "id": { "type": "string", "description": "Unique objective ID" },
        "userId": { "type": "string", "description": "Owner UID" },
        "title": { "type": "string", "description": "Objective title" },
        "description": { "type": "string", "description": "Objective description or notes" },
        "deadline": { "type": "string", "description": "Optional deadline YYYY-MM-DD" },
        "priority": { "type": "string", "description": "low | medium | high" },
        "progress": { "type": "number", "description": "Progress percentage 0-100" },
        "status": { "type": "string", "description": "not_started | in_progress | completed" },
        "reminder": { "type": "object", "description": "Reminder settings: { date, time, enabled, notes }" },
        "sourceReflectionId": { "type": "string", "description": "Associated journal reflection ID" },
        "sourceReflectionTitle": { "type": "string", "description": "Title of the journal entry" },
        "createdAt": { "type": "string", "description": "ISO timestamp" },
        "updatedAt": { "type": "string", "description": "ISO timestamp" }
      }
    },
    "Reminder": {
      "collection": "users/{userId}/reminders",
      "fields": {
        "id": { "type": "string", "description": "Unique reminder ID" },
        "userId": { "type": "string", "description": "Owner UID" },
        "title": { "type": "string", "description": "Reminder title" },
        "date": { "type": "string", "description": "YYYY-MM-DD" },
        "time": { "type": "string", "description": "HH:mm or null" },
        "status": { "type": "string", "description": "pending | completed | dismissed" },
        "sourceReflectionId": { "type": "string", "description": "Associated journal reflection ID" },
        "sourceReflectionTitle": { "type": "string", "description": "Associated reflection title" },
        "notes": { "type": "string", "description": "Reminder details" },
        "createdAt": { "type": "string", "description": "ISO timestamp" },
        "updatedAt": { "type": "string", "description": "ISO timestamp" }
      }
    },
    "FutureNote": {
      "collection": "users/{userId}/futureNotes",
      "fields": {
        "id": { "type": "string", "description": "Unique future note ID" },
        "userId": { "type": "string", "description": "Owner UID" },
        "message": { "type": "string", "description": "Personal note left for future self" },
        "targetDate": { "type": "string", "description": "YYYY-MM-DD or empty if someday" },
        "sourceReflectionId": { "type": "string", "description": "Associated reflection ID" },
        "sourceReflectionTitle": { "type": "string", "description": "Associated reflection title" },
        "sourceSentence": { "type": "string", "description": "Original sentence for highlight" },
        "status": { "type": "string", "description": "pending | delivered | read | archived" },
        "readAt": { "type": "string", "description": "ISO timestamp when read" },
        "createdAt": { "type": "string", "description": "ISO timestamp" },
        "updatedAt": { "type": "string", "description": "ISO timestamp" }
      }
    },
    "Scrapbook": {
      "collection": "users/{userId}/scrapbooks",
      "fields": {
        "id": { "type": "string", "description": "Unique scrapbook ID" },
        "userId": { "type": "string", "description": "Owner UID" },
        "sourceReflectionId": { "type": "string", "description": "Associated journal reflection ID" },
        "sourceReflectionTitle": { "type": "string", "description": "Title of original reflection" },
        "title": { "type": "string", "description": "Title of scrapbook page" },
        "date": { "type": "string", "description": "YYYY-MM-DD" },
        "template": { "type": "string", "description": "classic | photo_story | travel | achievement | personal | celebration | idea_board | project_diary" },
        "memoryType": { "type": "string", "description": "travel | achievement | personal | celebration | general" },
        "background": { "type": "object", "description": "Background texture/color configuration" },
        "elements": { "type": "array", "description": "Visual elements array (text, photos, stickers, tapes, badges)" },
        "metadata": { "type": "object", "description": "Extracted memory metadata (location, people, quotes, highlights)" },
        "lifeGraphNodeIds": { "type": "array", "description": "Linked Life Graph entity IDs" },
        "aiSuggestions": { "type": "array", "description": "Suggested enhancements from AI" },
        "createdAt": { "type": "string", "description": "ISO timestamp" },
        "updatedAt": { "type": "string", "description": "ISO timestamp" }
      }
    },
    "LifeGraphEntity": {
      "collection": "users/{userId}/lifeGraphEntities",
      "fields": {
        "id": { "type": "string", "description": "Unique entity ID" },
        "userId": { "type": "string", "description": "Owner UID" },
        "name": { "type": "string", "description": "Entity name e.g. AI Journal, Kochi, John" },
        "type": { "type": "string", "description": "project | person | place | goal | objective | event | topic | hobby | idea | achievement | memory" },
        "description": { "type": "string", "description": "Summary description" },
        "firstMentionedDate": { "type": "string", "description": "Date first appeared in reflections" },
        "lastMentionedDate": { "type": "string", "description": "Most recent reflection date" },
        "reflectionIds": { "type": "array", "description": "List of reflection IDs referencing this entity" },
        "objectiveIds": { "type": "array", "description": "Connected objective IDs" },
        "relatedPeople": { "type": "array", "description": "People connected with this entity" },
        "relatedTopics": { "type": "array", "description": "Topics connected with this entity" },
        "evolutionTimeline": { "type": "array", "description": "Milestones [{ date, monthLabel, stage, note, reflectionId }]" },
        "stats": { "type": "object", "description": "Counts: entryCount, objectiveCount, completedObjectives, peopleCount" },
        "color": { "type": "string", "description": "Visual node color hex/class" },
        "userEdited": { "type": "boolean", "description": "Whether user customized this entity" },
        "isUserHidden": { "type": "boolean", "description": "Whether user hid this entity from graph" },
        "createdAt": { "type": "string", "description": "ISO timestamp" },
        "updatedAt": { "type": "string", "description": "ISO timestamp" }
      }
    },
    "LifeGraphRelationship": {
      "collection": "users/{userId}/lifeGraphRelationships",
      "fields": {
        "id": { "type": "string", "description": "Unique relationship ID" },
        "userId": { "type": "string", "description": "Owner UID" },
        "sourceEntityId": { "type": "string", "description": "Source entity ID" },
        "targetEntityId": { "type": "string", "description": "Target entity ID" },
        "label": { "type": "string", "description": "Relationship label e.g. works on, visited, sub-goal of" },
        "type": { "type": "string", "description": "inferred | verified" },
        "strength": { "type": "number", "description": "Connection weight 1-5" },
        "reflectionIds": { "type": "array", "description": "Reflections evidencing this relationship" },
        "createdAt": { "type": "string", "description": "ISO timestamp" }
      }
    }
  }
}
